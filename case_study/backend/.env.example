# Server Port
PORT=5000

# Environment Mode
NODE_ENV=production

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# Database Name
DB_NAME=college_db

# Allowed Frontend Origins (Comma-separated for Vercel and Local testing)
# Example: https://your-project.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=https://student-records-app.vercel.app,http://localhost:5173
